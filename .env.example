# Copy to backend/.env for local development. Never commit .env.
# On AWS these values come from Secrets Manager (IMPLEMENTATION_PLAN.md §2.5).

NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Proxies in front of Express: 0 locally, 2 on AWS (CloudFront + load balancer)
TRUST_PROXY=0

# --- Database -------------------------------------------------------------
# Your MongoDB cluster connection string, including the database name, e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rento-vroom-dev?retryWrites=true&w=majority
MONGODB_URI=
# Optional. If connecting fails with "querySrv ECONNREFUSED", Node can't reach your DNS server
# (common on Windows). Set public DNS servers for Node's lookups, e.g. 8.8.8.8,1.1.1.1
DNS_SERVERS=

# --- Background jobs (plan §4.2) ---------------------------------------------
# Every backend process runs the job runner (emails, reminders, expiries) unless this is false
RUN_JOBS=true
# How many jobs each process runs at once
JOB_CONCURRENCY=2

# --- Frontend ---------------------------------------------------------------
# Used for links in emails
FRONTEND_URL=http://localhost:5173
# Comma-separated origins allowed to call the API with cookies (CORS + CSRF check)
FRONTEND_ORIGINS=http://localhost:5173

# --- Auth -------------------------------------------------------------------
# Signs the 15-minute access tokens. 32+ random characters, different per environment.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# Optional parent domain for auth cookies on staging/production, e.g. .rentovroom.co.nz
COOKIE_DOMAIN=
# Encrypts sensitive fields such as staff authenticator secrets (plan §14). 32 random bytes in base64,
# different per environment; changing it makes saved secrets unreadable. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# --- Email (Resend + React Email, plan §7) ----------------------------------
# "console" saves emails to backend/.mail/ instead of sending; "resend" sends through Resend
MAIL_DRIVER=console
# Required when MAIL_DRIVER=resend (https://resend.com/api-keys)
RESEND_API_KEY=
# Sender address on a domain verified in Resend (the plan uses a mail.<domain> subdomain)
EMAIL_FROM=Rento Vroom <hello@mail.example.com>
# Optional reply-to address
EMAIL_REPLY_TO=

# --- Phone codes (Twilio Verify, plan §6.1) ------------------------------
# "console" logs each code in the terminal instead of sending an SMS; "twilio" sends it
SMS_DRIVER=console
# Required when SMS_DRIVER=twilio (Twilio Console: Account info, and Verify > Services)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- Payments (Stripe, plan §8) --------------------------------------------
# Leave empty until you have them: the payment routes then answer 503 and everything else works.
# Sandbox secret key from Stripe Dashboard → Developers → API keys (starts with sk_test_). Charges are in NZD.
STRIPE_SECRET_KEY=
# The webhook's signing secret (starts with whsec_). Locally, `stripe listen --forward-to
# localhost:4000/api/v1/payments/webhook` (Stripe CLI) prints one; on AWS it's the Dashboard endpoint's.
STRIPE_WEBHOOK_SECRET=

# --- Local demo data --------------------------------------------------------
# Password for the demo accounts created by `npm run seed` (12+ characters). Ignored in production.
SEED_DEMO_PASSWORD=
# SMS notifications other than codes, e.g. new booking requests for Hosts (plan §7). With
# SMS_DRIVER=twilio, set one: a Messaging Service (MG…) or a Twilio number that can text NZ mobiles.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
# --- Location search (plan §1.2) --------------------------------------------
# "local" suggests our own NZ places only; "google" adds street addresses from Google Places
PLACES_DRIVER=local
# Required when PLACES_DRIVER=google: a server key restricted to the Places API (New)
GOOGLE_MAPS_SERVER_KEY=
# --- Photo and document uploads (plan §1.2) ---------------------------------
# "local" keeps files in UPLOAD_DIR and serves them from this API (development only; refused in
# production); "s3" uploads straight from the browser to the S3 bucket, using the usual AWS credentials
# (the ECS task role in production)
UPLOAD_DRIVER=local
UPLOAD_DIR=.uploads
# Required when UPLOAD_DRIVER=s3: the bucket, and where CloudFront serves its public/ folder
S3_BUCKET=
S3_REGION=ap-southeast-2
MEDIA_PUBLIC_URL=
# This API's address as browsers reach it, for links to files the local driver serves
API_PUBLIC_URL=http://localhost:4000
