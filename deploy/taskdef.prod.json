{
  "family": "rento-vroom-api-prod",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": { "cpuArchitecture": "X86_64", "operatingSystemFamily": "LINUX" },
  "executionRoleArn": "arn:aws:iam::935937182366:role/rento-vroom-ecs-execution",
  "taskRoleArn": "arn:aws:iam::935937182366:role/rento-vroom-ecs-task",
  "containerDefinitions": [
    {
      "name": "api",
      "image": "935937182366.dkr.ecr.ap-southeast-2.amazonaws.com/rento-vroom-backend:f92da00",
      "essential": true,
      "portMappings": [{ "containerPort": 4000, "protocol": "tcp" }],
      "stopTimeout": 60,
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "PORT", "value": "4000" },
        { "name": "TRUST_PROXY", "value": "2" },
        { "name": "LOG_LEVEL", "value": "info" },
        { "name": "FRONTEND_URL", "value": "https://www.rentovroom.com" },
        { "name": "FRONTEND_ORIGINS", "value": "https://www.rentovroom.com,https://staging.rentovroom.com" },
        { "name": "SENTRY_ENVIRONMENT", "value": "production" },
        { "name": "MAIL_DRIVER", "value": "resend" },
        { "name": "SMS_DRIVER", "value": "twilio" },
        { "name": "API_PUBLIC_URL", "value": "https://api.rentovroom.com" },
        { "name": "UPLOAD_DRIVER", "value": "s3" },
        { "name": "S3_BUCKET", "value": "rento-vroom-media-prod-935937182366" },
        { "name": "S3_REGION", "value": "ap-southeast-2" },
        { "name": "MEDIA_PUBLIC_URL", "value": "https://media.rentovroom.com" }
      ],
      "secrets": [
        {
          "name": "MONGODB_URI",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-2:935937182366:secret:rento-vroom/prod-Jd9Q8D:MONGODB_URI::"
        },
        {
          "name": "JWT_ACCESS_SECRET",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-2:935937182366:secret:rento-vroom/prod-Jd9Q8D:JWT_ACCESS_SECRET::"
        },
        {
          "name": "SENTRY_DSN",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-2:935937182366:secret:rento-vroom/prod-Jd9Q8D:SENTRY_DSN::"
        },
        {
          "name": "RESEND_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-2:935937182366:secret:rento-vroom/prod-Jd9Q8D:RESEND_API_KEY::"
        },
        {
          "name": "EMAIL_FROM",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-2:935937182366:secret:rento-vroom/prod-Jd9Q8D:EMAIL_FROM::"
        },
        {
          "name": "ENCRYPTION_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-2:935937182366:secret:rento-vroom/prod-Jd9Q8D:ENCRYPTION_KEY::"
        },
        {
          "name": "TWILIO_ACCOUNT_SID",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-2:935937182366:secret:rento-vroom/prod-Jd9Q8D:TWILIO_ACCOUNT_SID::"
        },
        {
          "name": "TWILIO_AUTH_TOKEN",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-2:935937182366:secret:rento-vroom/prod-Jd9Q8D:TWILIO_AUTH_TOKEN::"
        },
        {
          "name": "TWILIO_VERIFY_SERVICE_SID",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-2:935937182366:secret:rento-vroom/prod-Jd9Q8D:TWILIO_VERIFY_SERVICE_SID::"
        },
        {
          "name": "STRIPE_SECRET_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-2:935937182366:secret:rento-vroom/prod-Jd9Q8D:STRIPE_SECRET_KEY::"
        },
        {
          "name": "STRIPE_WEBHOOK_SECRET",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-2:935937182366:secret:rento-vroom/prod-Jd9Q8D:STRIPE_WEBHOOK_SECRET::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/rento-vroom-api-prod",
          "awslogs-region": "ap-southeast-2",
          "awslogs-stream-prefix": "api"
        }
      }
    }
  ]
}
