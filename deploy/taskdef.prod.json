{
  "family": "rento-vroom-api-prod",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": { "cpuArchitecture": "X86_64", "operatingSystemFamily": "LINUX" },
  "executionRoleArn": "arn:aws:iam::935937182366:role/rento-vroom-ecs-execution",
  "containerDefinitions": [
    {
      "name": "api",
      "image": "935937182366.dkr.ecr.ap-southeast-2.amazonaws.com/rento-vroom-backend:ba8e073",
      "essential": true,
      "portMappings": [{ "containerPort": 4000, "protocol": "tcp" }],
      "stopTimeout": 60,
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "PORT", "value": "4000" },
        { "name": "TRUST_PROXY", "value": "2" },
        { "name": "LOG_LEVEL", "value": "info" },
        { "name": "FRONTEND_URL", "value": "https://www.rentovroom.com" },
        { "name": "FRONTEND_ORIGINS", "value": "https://www.rentovroom.com" }
      ],
      "secrets": [
        {
          "name": "MONGODB_URI",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-2:935937182366:secret:rento-vroom/prod-Jd9Q8D:MONGODB_URI::"
        },
        {
          "name": "JWT_ACCESS_SECRET",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-2:935937182366:secret:rento-vroom/prod-Jd9Q8D:JWT_ACCESS_SECRET::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/rento-vroom-api-prod",
          "awslogs-region": "ap-southeast-2",
          "awslogs-stream-prefix": "api"
        }
      }
    }
  ]
}
