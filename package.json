{
  "name": "rento-vroom-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "openapi": "tsx scripts/openapi.ts",
    "seed": "tsx scripts/seed.ts",
    "db:indexes": "tsx scripts/sync-indexes.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "email:test": "tsx scripts/send-test-email.ts",
    "email:dev": "tsx watch scripts/email-preview.ts",
    "stripe:check": "tsx scripts/stripe-check.ts",
    "stripe:setup": "tsx scripts/stripe-setup.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1144.0",
    "@aws-sdk/s3-presigned-post": "^3.1144.0",
    "@aws-sdk/s3-request-presigner": "^3.1144.0",
    "@sentry/node": "^11.0.0",
    "@socket.io/mongo-adapter": "^0.4.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "heic-decode": "^2.1.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.14",
    "mongoose": "^8.24.4",
    "otplib": "^13.5.0",
    "pdfkit": "^0.17.2",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-email": "^6.11.0",
    "resend": "^6.29.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "stripe": "^22.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
